  "source": "CAM-LDS — Landauer, Hotwagner, Boenke, Skopik, Wurzenberger (AIT). arXiv:2603.04186v1 (2026).",
  "reconstruction_note": "Reconstructed from the paper: topology from Sec 3.2 / Fig 3; per-scenario technique sequences and objectives from Sec 3.4 and Figs 5-11; tactic coverage from Table 3. NOT the raw 18-source logs (those are for LLM log-interpretation and are irrelevant to the attacker model). Technique sequences are the CHARACTERISTIC condensed progression of the main variant of each scenario, sufficient to (a) define distinct latent campaign profiles and (b) estimate an attacker transition model. Sub-technique suffixes are kept; strip to parent for the sim vocab.",
  "usage": "Parameterizes the simulator (topology + latent profiles + a real-data held-out eval set). CAM-LDS is 34 runs / 243 steps => TOO SMALL to train on; it grounds structure, it is not a training corpus.",
  "dataset_scale": {"scenarios": 7, "simulations": 34, "attack_steps_total": 243, "techniques": 81, "tactics": 13, "os": "Linux", "collection": "scripted (AttackMate)"},

  "topology": {
    "segmentation_ref": "ISO/IEC 27033-3 five-zone enterprise segmentation (paper ref [47])",
    "hub": "Firewall",
    "zones": ["Internet", "DMZ", "LAN", "User", "Admin"],
    "hosts": {
      "Internet": ["CorpDNS", "PublicDNS", "Attacker"],
      "DMZ":      ["DockerServer", "RepositoryServer", "VideoServer"],
      "LAN":      ["FileShare", "AdminLAN"],
      "User":     ["Client"],
      "Admin":    ["AdminHost"]
    },
    "adjacency_model": "Star through the Firewall: every zone connects only to the Firewall; any cross-zone move requires firewall traversal. Attacker->DMZ/LAN/User/Admin all pass the firewall hub.",
    "default_entry_zone": "Internet",
    "notes": "In all scenarios but S5 the attacker gains initial access via the Internet zone; S5 starts inside the LAN (implanted device). Crown-jewel/target host varies per scenario (see scenarios[].target_host)."
  },

